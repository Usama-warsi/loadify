# SMTP settings
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_smtp_user@example.com
SMTP_PASS=your_smtp_password

# Destination email address for contact messages
CONTACT_TO=codrammer01@gmail.com

# Google reCAPTCHA v3 secret (server-side). Set this to enable verification.
RECAPTCHA_SECRET=replace-with-your-recaptcha-secret

# Optional: detection threshold for reCAPTCHA v3 (0.0 - 1.0). Default: 0.5
RECAPTCHA_THRESHOLD=0.5

# Comma-separated list of allowed origins for CORS (override defaults)
# Example: http://localhost:5173,http://localhost:3000,https://loadify.online
ALLOWED_ORIGINS=

# WordPress application password used to post contact submissions to
# codrammer.com via the WP REST API (Users > Profile > Application Passwords).
WP_USERNAME=replace-with-wp-username
WP_APP_PASSWORD=replace-with-wp-app-password
